<div id="<%= dom_id patient %>">
  <p>
    <strong>Name:</strong>
    <%= patient.name %>
  </p>

  <p>
    <strong>Date of birth:</strong>
    <%= patient.date_of_birth %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= patient.email %>
  </p>

  <p>
    <strong>Insurance:</strong>
    <%= patient.insurance_id %>
  </p>

  <p>
    <strong>Discount tier:</strong>
    <%= patient.discount_tier %>
  </p>

</div>
