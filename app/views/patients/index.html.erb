<p style="color: green"><%= notice %></p>

<h1>Patients</h1>

<%# Simple search form. Submits as GET /patients?q=... %>
<%= form_with url: patients_path, method: :get, local: true do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Search by name" %>
  <%= form.submit "Search" %>
<% end %>

<div id="patients">
  <% @patients.each do |patient| %>
    <%= render patient %>
    <p>
      <%= link_to "Show this patient", patient %>
    </p>
  <% end %>
</div>

<%= link_to "New patient", new_patient_path %> |
<%= link_to "All prescriptions", prescriptions_path %>
